# Copy to .env (ignored by git). server/publish.sh and guest/guix/release.py
# reach the roguix.frolow.dev VPS with these; authentication is your SSH key.
SSH_USER="user"
SSH_HOST="host"
SSH_PORT="port"
# omaguix/omaguix's scripts/vps-import on the VPS, which release.py runs
# there with a CI release tag.
VPS_IMPORT="/path/to/roguix/scripts/vps-import"
