+                [self isEventTapEnabled] ? "yes" : "no");
     }
 
     CFRunLoopRef runLoop = CFRunLoopGetCurrent();
@@ -1691,6 +1753,11 @@
     }
 }
 
+- (BOOL) isEventTapEnabled
+{
+    return eventsTap && CGEventTapIsEnabled(eventsTap);
+}
