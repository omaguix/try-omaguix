     if([alert runModal] == NSAlertSecondButtonReturn) {
@@ -1681,20 +1683,16 @@ - (BOOL)verifyQuit
 - (IBAction) do_about_menu_item: (id) sender
 {
     NSAutoreleasePool *pool = [[NSAutoreleasePool alloc] init];
