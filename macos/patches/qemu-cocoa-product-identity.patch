From: Try Omaguix contributors
Subject: [PATCH] cocoa: present the VM as Try Omaguix on macOS

Applies after startergo/homebrew-qemu-virgl-kosmickrisp v1.0.27.

QEMU owns the visible Cocoa window, so macOS gives its process the Dock entry
instead of the accessory launcher app. The app runs QEMU from a helper bundle
(Contents/Helpers/Try Omaguix.app) that supplies the process name, icon and
bundle identifier. Use the product name in QEMU's Cocoa window and application
menu, and hand a launch without arguments (a pinned Dock tile) to the
enclosing app.

diff --git a/ui/cocoa.m b/ui/cocoa.m
--- a/ui/cocoa.m
+++ b/ui/cocoa.m
@@ -1215,7 +1215,7 @@ - (void) grabMouse
     COCOA_DEBUG("QemuCocoaView: grabMouse\n");
 
     if (qemu_name)
-        [[self window] setTitle:[NSString stringWithFormat:@"QEMU %s - (Press  " UC_CTRL_KEY " " UC_ALT_KEY " G  to release Mouse)", qemu_name]];
+        [[self window] setTitle:[NSString stringWithFormat:@"%s - (Press  " UC_CTRL_KEY " " UC_ALT_KEY " G  to release Mouse)", qemu_name]];
     else
         [[self window] setTitle:@"QEMU - (Press  " UC_CTRL_KEY " " UC_ALT_KEY " G  to release Mouse)"];
     [self hideCursor];
@@ -1228,7 +1228,7 @@ - (void) ungrabMouse
     COCOA_DEBUG("QemuCocoaView: ungrabMouse\n");
 
