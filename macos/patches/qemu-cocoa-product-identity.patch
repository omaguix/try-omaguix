+/*
+ * The VM runs from a helper app bundle inside Try Omaguix.app
+ * (Contents/Helpers), whose Info.plist gives the process its name, icon and
+ * bundle identifier. A Dock tile pinned while the VM ran launches that helper
+ * without arguments; open the enclosing app, whose start menu starts the VM,
+ * instead of starting QEMU without a machine.
+ */
+static void __attribute__((constructor)) cocoa_open_enclosing_app(void)
+{
+    if (*_NSGetArgc() != 1) {
+        return;
+    }
+
+    NSAutoreleasePool *pool = [[NSAutoreleasePool alloc] init];
+    NSURL *helpers = [[[NSBundle mainBundle] bundleURL]
+                      URLByDeletingLastPathComponent];
+    NSURL *app = [[helpers URLByDeletingLastPathComponent]
+                  URLByDeletingLastPathComponent];
+
+    if (![[helpers lastPathComponent] isEqualToString:@"Helpers"] ||
+        ![[app pathExtension] isEqualToString:@"app"]) {
+        [pool release];
+        return;
+    }
+
+    dispatch_semaphore_t opened = dispatch_semaphore_create(0);
+    __block int status = 1;
+    [[NSWorkspace sharedWorkspace]
+        openApplicationAtURL:app
+               configuration:[NSWorkspaceOpenConfiguration configuration]
+           completionHandler:^(NSRunningApplication *application,
+                               NSError *error) {
+        if (application) {
+            status = 0;
+        } else {
+            fprintf(stderr, "Try Omaguix: cannot open %s: %s\n",
+                    [[app path] UTF8String],
+                    [[error localizedDescription] UTF8String]);
+        }
+        dispatch_semaphore_signal(opened);
+    }];
+    dispatch_semaphore_wait(opened, DISPATCH_TIME_FOREVER);
+    exit(status);
+}
+
 static void cocoa_display_init(DisplayState *ds, DisplayOptions *opts)
 {
     NSAutoreleasePool * pool = [[NSAutoreleasePool alloc] init];
