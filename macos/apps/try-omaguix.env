# Try Omaguix, this repository's own app: the identity `make` builds by
# default (APP_IDENTITY, macos/README.md "App identity"). Every key is
# required; macos/apps/identity.py reads and validates the file, and the
# Makefile includes it, so it stays plain KEY=value lines without quotes.
#
# The Roguix names were replaced in one cutover in October 2026 (decision
# d-n6eajaie): nobody used the app yet, so no older name is kept. Releases up
# to 0.5.1 were tagged v0.5.0 and try-roguix-v0.5.1 and published
# TryRoguix.dmg; an app built from this file does not look for them.
APP_NAME=Try Omaguix
GUEST_NAME=Omaguix
DEVELOPMENT_APP_NAME=Try Omaguix Dev
BUNDLE_IDENTIFIER=dev.tryomaguix.native
DEVELOPMENT_BUNDLE_IDENTIFIER=dev.tryomaguix.native.development
APPLICATION_SUPPORT_DIRECTORY=Try Omaguix
LOGS_DIRECTORY=Try Omaguix
LEGACY_APP_NAMES=
DEVELOPMENT_CERTIFICATE=Try Omaguix Development
DEVELOPMENT_KEYCHAIN=try-omaguix-development.keychain-db
DEVELOPMENT_KEYCHAIN_PASSWORD=try-omaguix/development-keychain-password
RELEASE_TAG_PREFIX=try-omaguix-v
RELEASE_DMG=TryOmaguix.dmg
LEGACY_RELEASE_DMGS=
RELEASE_REPOSITORY=omaguix/try-omaguix
ICON=TryOmaguix.svg
NETWORK_HELPER_SERVICE=dev.tryomaguix.network
