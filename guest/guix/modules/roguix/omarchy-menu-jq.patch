Omarchy 4.0.4's omarchy-menu-select and omarchy-menu-input build their JSON
payload with perl (Encode, JSON::PP), and Roguix's image has no perl, so the
menus built on them (the time zone menu among them) show nothing. Encode with
jq instead, which Omarchy already requires: options in order, an option per
argument (tabs, quotes, backslashes, newlines and empty options kept),
width and maxHeight as JSON numbers after checking they are whole numbers.
Bytes that are not UTF-8 become U+FFFD in both, so no option fails a menu;
the two may count one broken sequence as one or several replacements, though
the test's cases came out identical (test_omarchy_menu_jq.py). To be proposed
upstream; remove once the pinned Omarchy encodes without perl.

--- a/bin/omarchy-menu-select
+++ b/bin/omarchy-menu-select
@@ -67,24 +67,30 @@
   exit 1
 fi
 
+for value in "$menu_width" "$menu_maxheight"; do
+  if [[ -n $value && ! $value =~ ^[0-9]+$ ]]; then
+    echo "omarchy-menu-select: --width and --maxheight take a whole number, not '$value'" >&2
+    exit 1
+  fi
+done
+
 selection_file=$(mktemp)
 done_file=$(mktemp)
 rm -f "$done_file"
 trap 'rm -f "$selection_file" "$done_file"' EXIT
 
-options_json=$(perl -MEncode=decode -MJSON::PP=encode_json -e 'print encode_json([map { decode("UTF-8", $_) } @ARGV])' "${options[@]}")
-payload=$(perl -MEncode=decode -MJSON::PP=encode_json,decode_json -e '
-  my $payload = {
-    mode => "select",
-    prompt => decode("UTF-8", $ARGV[0]),
-    options => decode_json($ARGV[1]),
-    selectionFile => decode("UTF-8", $ARGV[2]),
-    doneFile => decode("UTF-8", $ARGV[3])
-  };
-  $payload->{width} = int($ARGV[4]) if length($ARGV[4] // "");
-  $payload->{maxHeight} = int($ARGV[5]) if length($ARGV[5] // "");
-  print encode_json($payload)
-' "$prompt" "$options_json" "$selection_file" "$done_file" "$menu_width" "$menu_maxheight")
+# jq replaces bytes that are not UTF-8 with U+FFFD, so no option fails the menu.
+payload=$(jq -cn \
+  --arg prompt "$prompt" \
+  --arg selectionFile "$selection_file" \
+  --arg doneFile "$done_file" \
+  --arg width "$menu_width" \
+  --arg maxHeight "$menu_maxheight" '
+  { mode: "select", prompt: $prompt, options: $ARGS.positional,
+    selectionFile: $selectionFile, doneFile: $doneFile }
+  + (if $width == "" then {} else { width: ($width | tonumber) } end)
+  + (if $maxHeight == "" then {} else { maxHeight: ($maxHeight | tonumber) } end)
+' --args -- "${options[@]}")
 
 omarchy-shell shell summon omarchy.menu "$payload" >/dev/null
 
--- a/bin/omarchy-menu-input
+++ b/bin/omarchy-menu-input
@@ -29,21 +29,25 @@
   shift
 done
 
+if [[ -n $menu_width && ! $menu_width =~ ^[0-9]+$ ]]; then
+  echo "omarchy-menu-input: --width takes a whole number, not '$menu_width'" >&2
+  exit 1
+fi
+
 selection_file=$(mktemp)
 done_file=$(mktemp)
 rm -f "$done_file"
 trap 'rm -f "$selection_file" "$done_file"' EXIT
 
-payload=$(perl -MEncode=decode -MJSON::PP=encode_json -e '
-  my $payload = {
-    mode => "input",
-    prompt => decode("UTF-8", $ARGV[0]),
-    selectionFile => decode("UTF-8", $ARGV[1]),
-    doneFile => decode("UTF-8", $ARGV[2])
-  };
-  $payload->{width} = int($ARGV[3]) if length($ARGV[3] // "");
-  print encode_json($payload)
-' "$prompt" "$selection_file" "$done_file" "$menu_width")
+# jq replaces bytes that are not UTF-8 with U+FFFD, so a prompt never fails the menu.
+payload=$(jq -cn \
+  --arg prompt "$prompt" \
+  --arg selectionFile "$selection_file" \
+  --arg doneFile "$done_file" \
+  --arg width "$menu_width" '
+  { mode: "input", prompt: $prompt, selectionFile: $selectionFile, doneFile: $doneFile }
+  + (if $width == "" then {} else { width: ($width | tonumber) } end)
+')
 
 omarchy-shell shell summon omarchy.menu "$payload" >/dev/null
 
