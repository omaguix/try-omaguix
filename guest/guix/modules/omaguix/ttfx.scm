;;; Omaguix — ttfx, the terminal text effects behind Omarchy's screensaver.
;;;
;;; Omarchy 4 runs its screensaver with ttfx (Omarchy 4e31b61a), a Rust port
;;; of terminaltexteffects, which the pinned Guix does not package. Unlike
;;; the apps of docs/decisions/0003, it publishes no release binary, and its
;;; whole dependency graph is already in Guix: the crate sources below are
;;; `guix import crate --lockfile' of its v0.5.0 Cargo.lock, 28 crates, each
;;; the same version and hash as the pinned Guix's (gnu packages
;;; rust-crates), so they are the same store items. Re-import them when the
;;; version changes.
(define-module (omaguix ttfx)
  #:use-module (guix packages)
  #:use-module (guix gexp)
  #:use-module (guix git-download)
  #:use-module (guix build-system cargo)
  #:use-module ((guix licenses) #:prefix license:)
  #:export (ttfx
            lookup-cargo-inputs))

(define ttfx
  (package
    (name "ttfx")
    (version "0.5.0")
    (source (origin
              (method git-fetch)
              (uri (git-reference
                    (url "https://github.com/omacom/ttfx")
                    (commit "112ebb310b848d8f1251a5c2919a9cd5a5c78e18")))
              (file-name (git-file-name name version))
              (sha256
               (base32
                "16ba0c5297ii2y673slqwhyaiqhlw0hdvxn18piymdkkiz593rb5"))))
    (build-system cargo-build-system)
    (arguments
     (list
      #:install-source? #f
      #:phases
      #~(modify-phases %standard-phases
          (add-after 'unpack 'relax-easing-goldens-test
            ;; The test expects glibc's libm to match the CPython goldens
            ;; bit for bit, but glibc picks sin, pow and others by CPU
            ;; (FMA/AVX2 variants or plain SSE2), so a Core 2 Duo differs
            ;; from the goldens' machine by 1 ulp (sin) and, through the
            ;; bezier's Newton steps, 17 ulp (2.4e-16); CPython on the same
            ;; CPU gives the same bits as ttfx. Use the test's own 1e-15
            ;; absolute bound of other platforms on Linux too: absolute,
            ;; since an ulp bound breaks down near the zero crossings of
            ;; the elastic and back easings.
            (lambda _
              (substitute* "tests/easing_goldens.rs"
                (("if cfg!\\(all\\(target_os = \"linux\", target_env = \"gnu\"\\)\\)")
                 "if false")))))))
    (inputs (cargo-inputs 'ttfx #:module '(omaguix ttfx)))
    (home-page "https://github.com/omacom/ttfx")
    (synopsis "Terminal text effects, a Rust port of terminaltexteffects")
    (description "ttfx animates text in a terminal with the effects of
TerminalTextEffects (beams, decrypt, matrix and others), with the same options,
as a single binary.")
    (license license:expat)))

