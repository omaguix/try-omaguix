#!/bin/bash
# Seed Omarchy's per-user files once for the desktop account, as the Arch
# guest's /etc/skel and first-run provisioning do, without their package
# installs, systemd units or browser setup. Runs from the tty1 login before
# Hyprland starts; later logins find the marker and return at once.
set -euo pipefail

omarchy=${OMARCHY_PATH:-/usr/share/omarchy}
state=$HOME/.local/state/omarchy
marker=$state/done/omaguix-seed
# Added after the first Omaguix images, so they also reach seeded accounts:
# fcitx5's input method groups (US and Chewing; US and Hangul) and the
# Chinese and Korean glyph preferences, all inert for English sessions.
omaguix_share=/run/current-system/profile/share/omaguix
mkdir -p "$HOME/.config/fcitx5" "$HOME/.config/fontconfig/conf.d"
if [[ ! -e $HOME/.config/fcitx5/profile ]]; then
  profile=$(<"$omaguix_share/fcitx5-profile")
  # A Korean system (LANG from the first-start setup) starts in the Korean
  # group: fcitx5 starts in the first group of GroupOrder.
  if [[ ${LANG:-} == ko_KR.* ]]; then
    profile=${profile/$'[GroupOrder]\n0=Default\n1=Korean'/$'[GroupOrder]\n0=Korean\n1=Default'}
  fi
  printf '%s\n' "$profile" >"$HOME/.config/fcitx5/profile"
fi
[[ -e $HOME/.config/fontconfig/conf.d/30-omaguix-cjk.conf ]] || \
  cp --no-preserve=mode "$omaguix_share/30-omaguix-cjk.conf" \
    "$HOME/.config/fontconfig/conf.d/30-omaguix-cjk.conf"

# Omarchy's screensaver is opt-in here: macOS has its own screensaver and
# lock, and an animation in the VM costs the Mac's CPU and battery. Turn
# Omarchy's own screensaver-off toggle on once per account, seeded ones too;
# Trigger > Toggle > Screensaver in Omarchy's menu turns it on, and that
# choice is kept.
if [[ ! -e $state/done/omaguix-screensaver-off ]]; then
  mkdir -p "$state/toggles" "$state/done"
  touch "$state/toggles/screensaver-off" "$state/done/omaguix-screensaver-off"
fi

# Omarchy's branding files, which the Arch package ships in /etc/skel: the
# screensaver animates screensaver.txt and About shows about.txt. Copied
# when missing, so seeded accounts get them too and the owner's stay.
mkdir -p "$HOME/.config/omarchy/branding"
for branding in logo.txt:screensaver.txt icon.txt:about.txt; do
  [[ -e $HOME/.config/omarchy/branding/${branding#*:} ]] || \
    cp --no-preserve=mode "$omarchy/${branding%%:*}" \
      "$HOME/.config/omarchy/branding/${branding#*:}"
done

# Omarchy's passwordless default keyring, as an installed Omarchy has: its
# own install/user/default-keyring.sh, which only creates what is missing.
bash "$omarchy/install/user/default-keyring.sh"

# Ensure the top-level foot config is present even on seeded accounts.
if [[ ! -e $HOME/.config/foot/foot.ini && -e $omarchy/config/foot/foot.ini ]]; then
  mkdir -p "$HOME/.config/foot"
  cp --no-preserve=mode "$omarchy/config/foot/foot.ini" \
    "$HOME/.config/foot/foot.ini"
fi

# A theme change before omarchy-theme-set-store-modes.patch could not remove
# current/theme's read-only backgrounds/ and moved next-theme inside it,
# leaving current/theme/foot.ini missing. Rebuild the active theme on login
# when its generated foot.ini is missing, even on an already-seeded account.
if [[ -e $marker && ! -s $state/current/theme/foot.ini ]]; then
  theme_name="Tokyo Night"
  if [[ -s $state/current/theme.name ]]; then
    read -r candidate <"$state/current/theme.name" || true
    [[ -n $candidate ]] && theme_name=$candidate
  fi
  OMARCHY_THEME_HEADLESS=1 OMARCHY_PATH=$omarchy PATH="$omarchy/bin:$PATH" \
    omarchy-theme-set "$theme_name" || \
    OMARCHY_THEME_HEADLESS=1 OMARCHY_PATH=$omarchy PATH="$omarchy/bin:$PATH" \
      omarchy-theme-set "Tokyo Night"
fi

[[ -e $marker ]] && exit 0

mkdir -p "$HOME/.config" "$state/done" "$state/toggles/hypr" \
  "$HOME/.local/share/applications" "$HOME/.config/fontconfig/conf.d"

# The pre-Omarchy Omaguix image gave every account its own small
# hyprland.lua; replace only that file, never one the owner wrote.
if grep -qs "A small native Guix session" "$HOME/.config/hypr/hyprland.lua"; then
  rm -f "$HOME/.config/hypr/hyprland.lua"
fi

# Store files are read-only; copies must be the owner's to edit.
copy_missing() {
  cp -rn --no-preserve=mode "$1" "$2"
}
copy_missing "$omarchy/config/." "$HOME/.config/"
copy_missing "$omarchy/applications/." "$HOME/.local/share/applications/"
copy_missing "$omarchy/default/hypr/toggles/flags.lua" "$state/toggles/hypr/flags.lua"
copy_missing "$omarchy/default/fontconfig/conf.avail/50-omarchy.conf" \
  "$HOME/.config/fontconfig/conf.d/50-omarchy.conf"

# The VM integration, where the Arch guest appends its QEMU fragment.
include='dofile("/etc/omaguix-hypr-vm.lua")'
if ! grep -qsF "$include" "$HOME/.config/hypr/monitors.lua"; then
  printf '\n-- Omaguix: cursor, display size and host bridges for this VM.\n%s\n' \
    "$include" >>"$HOME/.config/hypr/monitors.lua"
fi

# Omarchy's browser is Chromium; Omaguix's is LibreWolf.
xdg-settings set default-web-browser librewolf.desktop 2>/dev/null || true

# Build ~/.local/state/omarchy/current/theme without a running session.
OMARCHY_THEME_HEADLESS=1 OMARCHY_PATH=$omarchy PATH="$omarchy/bin:$PATH" \
  omarchy-theme-set "Tokyo Night"

# Omarchy's first-run and user provisioning install Arch packages and systemd
# units; mark them done, and mark shipped migrations applied, as a fresh
# Omarchy install does.
touch "$state/done/first-run-user" "$state/done/finalize-user"
mkdir -p "$state/migrations"
for migration in "$omarchy"/migrations/*.sh; do
  [[ -f $migration ]] && touch "$state/migrations/${migration##*/}"
done

touch "$marker"
